{
  "schema_version": 1,
  "status": "FIRST_FULL_NETWORK_PASS",
  "purpose": "Define how resources physically move between the currently designated production, processing and export islands. The network is part of gameplay and worldbuilding: cargo should have visible origins, transfer nodes, routes, return flows and destination industries.",
  "network_rules": [
    "Bulk low-value cargo prefers canal, barge, coastal ship or heavy rail. High-value compact cargo can use rail, guarded courier freight or fast ship routes.",
    "Nether cargo exits through Ember Coast controlled portal infrastructure before entering the surface network. End cargo exits through Shrouded Isles controlled access before entering Transit routes.",
    "Grand Exchange is the major redistribution hub but direct producer-to-consumer routes are preferred when they are geographically/logistically sensible.",
    "Transit Isles is the major mode-transfer hub: ship-to-rail, rail-to-ferry, freight-to-portal staging and long-distance passenger/rocket operations.",
    "Return freight matters: empty containers, shulker boxes, tools, machine parts, food and maintenance stock should move back toward producers.",
    "Every production island must have at least one primary outbound path and at least one believable inbound supply path.",
    "Local roads, boardwalks, canals and causeways connect districts inside a region before long-distance freight begins.",
    "Dangerous cargo uses separated depots, bonded warehouses or restricted terminals rather than ordinary civic docks."
  ],
  "transport_modes": {
    "local_road": "Short regional movement for food, tools, workers and moderate cargo; architecture follows the local civilization.",
    "canal_barge": "Breadbasket and wetland bulk movement; slow, high-capacity and visually integrated into water-management infrastructure.",
    "river_barge": "Timber and agricultural bulk transport from interior production to export docks.",
    "coastal_ship": "Default interregional bulk movement around the archipelago.",
    "blue_water_ship": "Longer southern/northern sea routes and high-capacity maritime trade.",
    "heavy_rail": "Stone, iron, machine parts and standardized freight between major hubs where fixed infrastructure is justified.",
    "passenger_rail": "Transit-oriented movement with limited cargo capacity and strong station architecture.",
    "secure_freight": "Restricted movement for gunpowder, sculk, wither-related goods and other hazardous/high-value cargo.",
    "portal_freight": "Controlled Nether movement through Ember Coast portal bastions, always paired with a surface transfer node.",
    "end_gateway_freight": "Controlled End movement through Shrouded Isles expedition compounds, always paired with Transit staging.",
    "deep_lift": "Crystal Deep vertical freight to surface/Transit transfer points.",
    "ferry": "Short inter-island passenger and mixed cargo movement, especially Transit, Hearthlands and Blackfen.",
    "rocket_flight": "Player-focused long-distance movement and small urgent cargo only; not a bulk freight replacement."
  },
